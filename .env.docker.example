# ─────────────────────────────────────────────────────────────────────────
#  Variables del entorno de pruebas en contenedores.
#
#  Cópialo a .env en el servidor y reemplaza TODO lo que diga "cambiame".
#  Este archivo se versiona; el .env real NO, y tampoco entra a la imagen.
# ─────────────────────────────────────────────────────────────────────────

APP_NAME="Taquilla ZooMAT"

# `staging` habilita la pasarela simulada (config/taquilla.php →
# taquilla.pago.entornos_simulada) sin abrirle la puerta a producción.
APP_ENV=staging

# Jamás true en un servidor alcanzable: las pantallas de error de Laravel
# muestran las credenciales de la base.
APP_DEBUG=false

# ⚠️ GENERALA UNA SOLA VEZ Y NO LA CAMBIES.
#
#   docker compose run --rm --no-deps app php artisan key:generate --show
#
# Los códigos QR se firman con esta llave. Si la cambias, todos los boletos
# ya emitidos dejan de validar en el acceso y la gente se queda afuera con
# su compra pagada.
APP_KEY=

# La URL pública real. De aquí salen los enlaces del correo del comprobante
# y el callback de Google.
APP_URL=https://cambiame.ejemplo.mx

APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es_MX
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ── Puerto publicado en el host ─────────────────────────────────────────
# Detrás de un proxy que termine TLS. No expongas el 80 directo a internet.
APP_PORT=8080

# ── Base de datos ───────────────────────────────────────────────────────
# `db` es el nombre del servicio en compose, no un host externo.
#
# Usa contraseña ALFANUMÉRICA. Compose interpola `$` en las variables, y una
# contraseña con `$`, `!` o `#` provoca fallos de conexión difíciles de
# rastrear, porque el error no dice que el problema sea el password.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=taquilla_zoomat
DB_USERNAME=taquilla
DB_PASSWORD=cambiame_password_alfanumerico

# ── Sesión, cola y caché ────────────────────────────────────────────────
# Los tres van en la base, y las tres tablas existen en las migraciones.
# QUEUE_CONNECTION=database es lo que hace que el servicio `queue` tenga
# trabajo: con `sync` el correo del comprobante se enviaría dentro del
# webhook y el banco lo daría por fallido.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Con TLS delante, ponla en true.
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=database
CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Correo ──────────────────────────────────────────────────────────────
# La cuenta que ya opera el sistema. Por aquí sale el comprobante con el QR,
# así que si esto no funciona, el visitante paga y no recibe su boleto.
#
# MAIL_SCHEME es el nombre que lee Laravel 12 (config/mail.php). `smtp` va
# con el puerto 587 y `smtps` con el 465; MAIL_ENCRYPTION ya no existe.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=semahntickets@gmail.com

# Contraseña de APLICACIÓN de Google, no la del correo. Se deja vacía porque
# este archivo se versiona: va en el .env.docker del servidor, nunca aquí.
MAIL_PASSWORD=

MAIL_FROM_ADDRESS="semahntickets@gmail.com"
MAIL_FROM_NAME="ZooMAT"

# ── Pasarela de pago ────────────────────────────────────────────────────
# `simulada` no cobra dinero: sirve para probar el recorrido completo hasta
# el QR. Solo opera en los entornos listados en config/taquilla.php.
PAGO_PASARELA=simulada

# Si se deja vacío cae en APP_KEY. Para pruebas basta; cuando haya proveedor
# real, aquí va el secreto que entregue.
PAGO_SECRETO_WEBHOOK=

# ── Google OAuth ────────────────────────────────────────────────────────
# Opcional. Sin estas credenciales el botón "Continuar con Google" falla.
# El URI de retorno debe estar dado de alta en la consola de Google con el
# dominio real: Google no acepta http salvo en localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
